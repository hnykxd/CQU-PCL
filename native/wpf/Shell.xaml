<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7FB">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#174C83"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#22354D"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#284263"/>
      <Setter Property="BorderBrush" Value="#DCE5F0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.975" ScaleY="0.975"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#174C83"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#174C83"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#174C83"/>
    </Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="12,3"/><Setter Property="Padding" Value="18,13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DAE3EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#22354D"/><Setter Property="Background" Value="#FAFCFF"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#174C83"/><Setter TargetName="Input" Property="Background" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#A3BCD8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Input" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DAE3EE"/><Setter Property="Background" Value="#FAFCFF"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#174C83"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="3,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#F0F5FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="#E5EEF9"/><Setter Property="Foreground" Value="#174C83"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#284263"/><Setter Property="BorderBrush" Value="#DAE3EE"/><Setter Property="Background" Value="#FAFCFF"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton x:Name="SelectionToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ChoiceBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="7"><Grid><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#65809F" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#A3BCD8"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#174C83"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,9,34,9" VerticalAlignment="Center"/>
        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
          <Border Background="White" BorderBrush="#D5E0EF" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Padding="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" Background="#D0DBE8" CornerRadius="4" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#A8BDD5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Foreground" Value="#174C83"/><Setter Property="Background" Value="#E9EFF7"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="2" Grid.Row="0" Background="White" BorderBrush="#E9EEF5" BorderThickness="0,0,0,1">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeWindow" Content="—" Width="46" Height="38" ToolTip="最小化" Padding="0" BorderThickness="0"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Hit" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#EAF0F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
        <Button x:Name="MaximizeWindow" Content="□" Width="46" Height="38" ToolTip="最大化 / 还原" Padding="0" BorderThickness="0"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Hit" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#EAF0F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
        <Button x:Name="CloseWindow" Content="×" Width="46" Height="38" FontSize="21" ToolTip="关闭" Padding="0" BorderThickness="0"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Hit" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#C94351"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
      </StackPanel>
      <TextBlock Text="CQU PCL  ·  奶蛙医学院" Foreground="#8596AD" FontSize="11" VerticalAlignment="Center" Margin="22,0,0,0"/>
    </DockPanel>
  </Border>
  <Border Grid.Row="1" Grid.RowSpan="2" Background="White" BorderBrush="#E3EAF3" BorderThickness="0,0,1,0">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="26,24,20,22">
        <StackPanel Orientation="Horizontal"><Image x:Name="BrandLogo" Width="48" Height="48" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="CQU PCL" FontSize="21" FontWeight="Bold" Foreground="#174C83"/><TextBlock Text="奶蛙医学院" FontSize="10" Foreground="#7B8EA7" Margin="1,3,0,0"/></StackPanel></StackPanel>
        <TextBlock Text="每一个世界，都由你开始" FontSize="11" Foreground="#8897AB" Margin="1,13,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
        <Border Background="#FFF8DC" CornerRadius="8" Padding="14">
          <StackPanel><TextBlock Text="独立世界 · 自由探索" FontSize="12" Foreground="#78663D"/><TextBlock Text="NAIWA  /  SINCE 1929" FontSize="9" Foreground="#A69B77" Margin="0,6,0,0"/></StackPanel>
        </Border>
      </StackPanel>
      <StackPanel>
        <Button x:Name="NavHome" Content="▶     开始游戏" Tag="home" Style="{StaticResource Navigation}"/>
        <Button x:Name="NavInstances" Content="▣     我的世界" Tag="instances" Style="{StaticResource Navigation}"/>
        <Button x:Name="NavDownloads" Content="↓     下载游戏" Tag="downloads" Style="{StaticResource Navigation}"/>
        <Button x:Name="NavPacks" Content="◇     整合包" Tag="packs" Style="{StaticResource Navigation}"/>
        <Button x:Name="NavMods" Content="＋     模组" Tag="mods" Style="{StaticResource Navigation}"/>
        <Border Height="1" Background="#EDF1F7" Margin="28,18,28,16"/>
        <Button x:Name="NavTasks" Content="≡     下载任务" Tag="tasks" Style="{StaticResource Navigation}"/>
        <Button x:Name="NavAccount" Content="◉     玩家账户" Tag="account" Style="{StaticResource Navigation}"/>
        <Button x:Name="NavSettings" Content="⚙     设置" Tag="settings" Style="{StaticResource Navigation}"/>
      </StackPanel>
    </DockPanel>
  </Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="32,25,32,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,25">
      <Button x:Name="AccountShortcut" DockPanel.Dock="Right" Padding="14,8" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#2874E8" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="ProfileName" Text="CQU_Player" FontWeight="SemiBold"/><TextBlock x:Name="ProfileMode" Text="离线登录" FontSize="10" Foreground="#8999AD"/></StackPanel></StackPanel>
      </Button>
      <StackPanel><TextBlock x:Name="PageTitle" Text="开始游戏" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="你的下一个世界，从这里开始。" Foreground="#8191A6" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    </DockPanel>
    <Grid x:Name="PageHost" Grid.Row="1">
      <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Background="#E9F0FA" CornerRadius="14" Padding="28" MinHeight="255">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="NAIWA  /  下一站，方块世界" Foreground="#5C7DA6" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock x:Name="WorldName" Text="创造你的第一个世界" FontSize="29" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <TextBlock x:Name="WorldSummary" Text="从原版开始，也可以导入你喜欢的整合包。" Foreground="#6783AA" FontSize="13"/>
                <TextBlock x:Name="WorldStatus" Text="存档、模组与配置，独立存放。" Foreground="#6783AA" Margin="0,14,0,20" FontSize="11"/>
                <StackPanel Orientation="Horizontal"><Button x:Name="LaunchButton" Content="▶   开启新世界" Style="{StaticResource Primary}" FontSize="15" Padding="26,13"/><Button x:Name="WorldSettingsButton" Content="世界设置" Margin="10,0,0,0"/></StackPanel>
              </StackPanel>
              <Viewbox Grid.Column="1" Width="210" Height="178" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                <Canvas Width="220" Height="185">
                  <Ellipse Canvas.Left="12" Canvas.Top="149" Width="198" Height="28" Fill="#C9DAF2"/>
                  <Polygon Points="22,76 111,25 202,76 111,128" Fill="#80B592"/>
                  <Polygon Points="22,76 111,128 111,165 22,113" Fill="#947661"/>
                  <Polygon Points="111,128 202,76 202,113 111,165" Fill="#775E50"/>
                  <Polygon Points="22,76 111,128 111,140 22,88" Fill="#579671"/>
                  <Polygon Points="111,128 202,76 202,88 111,140" Fill="#438563"/>
                  <Polygon Points="73,72 110,51 148,72 110,94" Fill="#A3CCAC"/>
                  <Polygon Points="155,45 179,31 201,44 178,59" Fill="#F8E28B"/>
                  <Polygon Points="155,45 178,59 178,75 155,62" Fill="#E7CA6D"/>
                  <Polygon Points="178,59 201,44 201,62 178,75" Fill="#CDB058"/>
                  <Polygon Points="24,39 43,28 62,39 43,50" Fill="White"/>
                  <Polygon Points="24,39 43,50 43,63 24,51" Fill="#D6E4F8"/>
                  <Polygon Points="43,50 62,39 62,51 43,63" Fill="#B8CFEE"/>
                </Canvas>
              </Viewbox>
            </Grid>
          </Border>
          <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="8" Padding="18,12" Margin="0,14,0,20">
            <DockPanel><TextBlock Text="当前世界" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"/><ComboBox x:Name="WorldSelector" MinWidth="170" MaxWidth="440" HorizontalAlignment="Left"/><TextBlock x:Name="LastPlayed" Text="等待第一次冒险" FontSize="11" Foreground="#91A0B3" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
          </Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="9" Padding="22"><StackPanel><TextBlock Text="创建一个新世界" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="选择 Minecraft 版本与模组加载器。" FontSize="12" Foreground="#8393A8" Margin="0,8,0,16"/><Button x:Name="CreateWorldButton" Content="＋   创建并安装" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="22"><StackPanel><TextBlock Text="带上你的整合包" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="支持 Modrinth / CurseForge，或拖入文件。" FontSize="12" Foreground="#8393A8" Margin="0,8,0,16"/><Button x:Name="ImportPackButton" Content="↑   导入整合包" HorizontalAlignment="Left"/></StackPanel></Border>
          </Grid>
          <TextBlock Text="存档、模组、资源包与运行环境均按世界隔离。" Foreground="#95A3B6" FontSize="11" Margin="2,23,0,8"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="InstancesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InstancesList"/></ScrollViewer>
      <ScrollViewer x:Name="DownloadsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DownloadsContent"/></ScrollViewer>
      <Grid x:Name="CatalogPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
          <DockPanel><Button x:Name="SearchButton" Content="搜索" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="10,0,0,0"/><TextBox x:Name="SearchBox" ToolTip="搜索 Modrinth 内容"/></DockPanel>
          <TextBlock x:Name="CatalogHint" FontSize="11" Foreground="#8495AC" Margin="0,9,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CatalogList"/></ScrollViewer>
      </Grid>
      <ScrollViewer x:Name="TasksPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TasksList"/></ScrollViewer>
      <ScrollViewer x:Name="AccountPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AccountContent"/></ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsContent"/></ScrollViewer>
    </Grid>
  </Grid>
  <Border Grid.Row="2" Grid.Column="1" Background="#EAF0F8" Padding="18,0">
    <DockPanel><TextBlock x:Name="SourceStatus" DockPanel.Dock="Right" Text="连接中" FontSize="10" Foreground="#788BA4" VerticalAlignment="Center"/><TextBlock x:Name="StatusMessage" Text="正在启动服务…" FontSize="11" Foreground="#6480A4" VerticalAlignment="Center" Margin="0,0,14,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
  </Border>
  <Border x:Name="Toast" Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,26" Background="#174C83" CornerRadius="9" Padding="18,12" Visibility="Collapsed" MaxWidth="640" Panel.ZIndex="20" IsHitTestVisible="False"><TextBlock x:Name="ToastText" Foreground="White" FontSize="12"/></Border>
  <Border x:Name="DropHint" Grid.ColumnSpan="2" Grid.RowSpan="3" Background="#EEEDF3FC" BorderBrush="#174C83" BorderThickness="2" CornerRadius="14" Margin="14" Visibility="Collapsed" Panel.ZIndex="30" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image x:Name="DropLogo" Width="86" Height="86" Margin="0,0,0,20"/><TextBlock Text="把整合包带到这里" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="松开即可识别 .mrpack / CurseForge ZIP" FontSize="13" Foreground="#6F86A2" Margin="0,12,0,0"/></StackPanel></Border>
</Grid>
