<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CQU-PCL-Native</AssemblyName>
    <RootNamespace>CquPcl.Native</RootNamespace>
    <LangVersion>5</LangVersion>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ApplicationIcon>../../public/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
    <EmbeddedResource Include="Shell.xaml" LogicalName="Shell.xaml" />
    <EmbeddedResource Include="../../public/brand/logo.png" LogicalName="brand-logo.png" />
    <EmbeddedResource Include="../../.build-cache/native-payload.zip" LogicalName="payload.zip" Condition="Exists('../../.build-cache/native-payload.zip')" />
  </ItemGroup>
</Project>
